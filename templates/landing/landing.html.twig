{% extends 'base.html.twig' %}
{% import 'macros.twig' as macros %}

{% block stylesheets %}
  {{ encore_entry_link_tags('jquery_ui') }}
  {{ encore_entry_link_tags('leaflet') }}
{% endblock stylesheets %}

{% block javascripts %}
  {{ encore_entry_script_tags('landing') }}
  {{ encore_entry_script_tags('jquery_ui') }}
{% endblock javascripts %}

{% block content %}

<div class="l-landing-welcome u:my-32">

	{% include 'landing/widget/profilepicturewithaccommodation.html.twig' with {
    member: app.user
    } only %}

	<div class="l-welcome-strip__info">
		<p class="l-welcome-strip__label">{{ 'landing.welcomeback' | trans }}</p>
		<div class="l-welcome-strip__name-row">
			<p class="l-welcome-strip__name">{{ macros.profilelink(app.user.Username) }}</p>
			{% if not app.user.Accommodation is null %}
			{{ form_start(searchLocation, { 'action': path('search_locations'), 'attr': {'class': 'l-welcome-strip__city-form'} }) }}
			<button type="submit" id="home_updateMap" name="home[updateMap]" class="searchsubmit l-welcome-strip__city btn">
				<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
				{{ searchLocation.vars.value.location }}
			</button>
			{% do searchLocation.updateMap.setRendered %}
			<div class="d-none invisible">{{ form_rest(searchLocation) }}</div>
			{{ form_end(searchLocation) }}
			{% endif %}
		</div>
		{% if not app.user.Accommodation is null %}
		<div class="l-welcome-strip__meta">
			{% include 'landing/widget/accommodation.html.twig' with { member: app.user } only %}
		</div>
		{% else %}
			<p class="l-welcome-strip__not-setup">{{ 'profile.created'|trans }}</p>
		{% endif %}
	</div>

	<div class="l-welcome-strip__search">
		{{ form_start(tinySearch, { 'action': path('search_locations'), 'attr': {'class': 'u:w-full'} }) }}
		<label for="{{ tinySearch.location.vars.id }}" class="visually-hidden">{{ 'landing.whereyougo' | trans }}</label>
		<div class="l-welcome-strip__search-bar">
			<div class="auto-search-wrapper max-height loupe">
				<input type="text"
					id="{{ tinySearch.location.vars.id }}"
					name="{{ tinySearch.location.vars.full_name }}"
					class="l-welcome-strip__search-input js-location-picker"
					autocomplete="off"
					placeholder="{{ 'landing.whereyougo' | trans }}"
					aria-label="{{ 'landing.whereyougo' | trans }}"
					{% if tinySearch.location.vars.value %}value="{{ tinySearch.location.vars.value }}"{% endif %}
				>
			</div>
			<button type="submit" id="tiny_updateMap" name="{{ tinySearch.updateMap.vars.name }}" class="l-welcome-strip__search-btn">
				{{ 'go'|trans }}
				<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 18 15 12 9 6"/></svg>
			</button>
		</div>
		<div class="u:block">{{ form_errors(tinySearch.location) }}</div>
		{% do tinySearch.location.setRendered %}
		{% do tinySearch.updateMap.setRendered %}
		<div class="d-none" aria-hidden="true">{{ form_rest(tinySearch) }}</div>
		{{ form_end(tinySearch) }}
	</div>
</div>

{#
  The two main blocks: messages and visitors, then forum, activities and notifications.
  Each is a card with its tabs on top; the lists are loaded by landing.js.
  The filter pills keep the "active" class landing.js reads when it reloads a list.
#}
{% set loading %}
    <p class="c-home-list__loading"><i class="fa fa-spinner fa-pulse" aria-hidden="true"></i></p>
{% endset %}
<div class="c-home-blocks">

    {# messages and visitors #}
    <section class="c-home-card">
        <ul class="nav c-home-tabs" role="tablist">
            <li class="nav-item" role="presentation">
                <a class="nav-link c-home-tabs__link active" aria-controls="conversations" href="#conversations" role="tab" data-bs-toggle="tab">
                    {{ 'landing.tab.messagesreceived'|trans }}
                    {% if conversationCount %}<span class="c-home-tabs__count">{{ conversationCount }}</span>{% endif %}
                </a>
            </li>
            <li class="nav-item" role="presentation">
                <a class="nav-link c-home-tabs__link" aria-controls="visitors" href="#visitors" role="tab" data-bs-toggle="tab">
                    {{ 'landing.tab.visitors'|trans }}
                    {% if visitorsCount %}<span class="c-home-tabs__count">{{ visitorsCount }}</span>{% endif %}
                </a>
            </li>
        </ul>

        <div class="tab-content c-home-card__content">
            <div role="tabpanel" class="tab-pane c-home-pane active" id="conversations">
                <div class="c-home-pane__filters" role="radiogroup" aria-label="{{ 'landing.tab.messagesreceived'|trans }}">
                    <button type="button" class="c-home-pill js-home-filter{% if messageFilter != 'Unread' %} active{% endif %}" id="all" role="radio" aria-checked="{{ messageFilter != 'Unread' ? 'true' : 'false' }}" data-group="messages">{{ 'landing.button.all'|trans }}</button>
                    <button type="button" class="c-home-pill js-home-filter{% if messageFilter == 'Unread' %} active{% endif %}" id="unread" role="radio" aria-checked="{{ messageFilter == 'Unread' ? 'true' : 'false' }}" data-group="messages">{{ 'landing.button.unread'|trans }}</button>
                </div>
                <div id="conversationsdisplay" class="c-home-list">{{ loading }}</div>
                <div class="c-home-pane__footer">
                    <a class="c-home-link" href="{{ url('conversations', { conversationsType: 'conversations' }) }}">{{ 'landing.conversations'|trans }} <i class="fas fa-arrow-right" aria-hidden="true"></i></a>
                </div>
            </div>

            <div role="tabpanel" class="tab-pane c-home-pane" id="visitors">
                {{ form_start(radiusForm, { attr: { class: 'c-home-pane__radius' } }) }}
                    <i class="fa fa-bullseye" aria-hidden="true"></i>
                    {{ form_label(radiusForm.radius, null, { label_attr: { class: 'c-home-pane__radius-label' } }) }}
                    {{ form_widget(radiusForm.radius, { attr: { class: 'c-home-pane__radius-select' } }) }}
                    {{ form_rest(radiusForm) }}
                {{ form_end(radiusForm) }}
                <div id="legsdisplay" class="c-home-list">{{ loading }}</div>
                <div class="c-home-pane__footer">
                    <a class="c-home-link" href="{{ url('visitors') }}"><i class="far fa-map" aria-hidden="true"></i> {{ 'landing.bevisited.alltrips'|trans }}</a>
                </div>
            </div>
        </div>
    </section>

    {# forum, activities and notifications #}
    <section class="c-home-card">
        <ul class="nav c-home-tabs" role="tablist">
            <li class="nav-item" role="presentation">
                <a class="nav-link c-home-tabs__link active" aria-controls="threads" href="#threads" role="tab" data-bs-toggle="tab">{{ 'landing.tab.forum'|trans }}</a>
            </li>
            <li class="nav-item" role="presentation">
                <a class="nav-link c-home-tabs__link" aria-controls="activities" href="#activities" role="tab" data-bs-toggle="tab">
                    {{ 'landing.tab.activities'|trans }}
                    {% if activityCount %}<span class="c-home-tabs__count">{{ activityCount }}</span>{% endif %}
                </a>
            </li>
            <li class="nav-item" role="presentation">
                <a class="nav-link c-home-tabs__link" aria-controls="notifications" href="#notifications" role="tab" data-bs-toggle="tab">
                    {{ 'landing.tab.notifications'|trans }}
                    {% if notificationCount %}<span class="c-home-tabs__count">{{ notificationCount }}</span>{% endif %}
                </a>
            </li>
        </ul>

        <div class="tab-content c-home-card__content">
            <div role="tabpanel" class="tab-pane c-home-pane active" id="threads">
                {% set showGroups = forumFilter == 'GroupsAndForums' or forumFilter == 'Groups' %}
                {% set showForums = forumFilter == 'GroupsAndForums' or forumFilter == 'Forums' %}
                <div class="c-home-pane__filters" role="group" aria-label="{{ 'landing.tab.forum'|trans }}">
                    <button type="button" class="c-home-pill js-home-filter{% if showGroups %} active{% endif %}" id="groupsButton" aria-pressed="{{ showGroups ? 'true' : 'false' }}">{{ 'landing.button.groups'|trans|capitalize }}</button>
                    <button type="button" class="c-home-pill js-home-filter{% if showForums %} active{% endif %}" id="forumButton" aria-pressed="{{ showForums ? 'true' : 'false' }}">{{ 'landing.button.forum'|trans|capitalize }}</button>
                </div>
                <div id="threadsdisplay" class="c-home-list">{{ loading }}</div>
                <div class="c-home-pane__footer">
                    <a class="c-home-link" href="/forums"><i class="fas fa-comments" aria-hidden="true"></i> {{ 'landing.button.discussions'|trans }}</a>
                    <a class="c-home-link" href="/groups/mygroups"><i class="fas fa-users" aria-hidden="true"></i> {{ 'landing.button.mygroups'|trans }}</a>
                    <a class="c-home-link" href="/forums/subscriptions"><i class="fas fa-check-square" aria-hidden="true"></i> {{ 'landing.button.subscriptions'|trans }}</a>
                </div>
            </div>

            <div role="tabpanel" class="tab-pane c-home-pane" id="activities">
                <div class="c-home-pane__filters">
                    <label class="c-home-switch">
                        <input type="checkbox" id="show_online" name="show_online"{% if onlineActivities %} checked{% endif %}>
                        <span class="c-home-switch__track" aria-hidden="true"></span>
                        {{ 'landing.activities.show.online'|trans }}
                    </label>
                    <a class="c-home-pill c-home-pill--action" href="/activities/create"><i class="fa fa-calendar-plus" aria-hidden="true"></i> {{ 'landing.activities.create'|trans }}</a>
                </div>
                <div id="activitiesdisplay" class="c-home-list">{{ loading }}</div>
                <div class="c-home-pane__footer">
                    <a class="c-home-link" href="/activities"><i class="fa fa-map" aria-hidden="true"></i> {{ 'landing.activities.allactivities'|trans }}</a>
                    <a class="c-home-link" href="/activities/myactivities"><i class="fa fa-calendar" aria-hidden="true"></i> {{ 'landing.activities.myactivities'|trans }}</a>
                </div>
            </div>

            <div role="tabpanel" class="tab-pane c-home-pane" id="notifications">
                <div id="notificationsdisplay" class="c-home-list">{{ loading }}</div>
            </div>
        </div>
    </section>
</div>

{# 3 columns #}
<div class="u:flex u:flex-wrap u:md:grid u:md:grid-cols-2 u:gap-24 u:pb-24">

	<div class="u:w-full">
		<div class="o-card u:mb-24">
        <h4 class="homehfour">{{ 'landing.beinvolved.title' | trans }}<br/><span
            class="homesubt">{{ 'landing.beinvolved.donate' | trans }}</span></h4>

        <p class="u:font-display u:text-center u:mb-16 u:font-300 u:text-18">{{ 'landing.beinvolved.goalfor' | trans }} {{ campaign.year }}
          - {{ campaign.year + 1 }}:
          <strong>€{{ campaign.yearNeeded }}</strong></p>

			{% if campaign.yearDonated < campaign.yearNeeded %}
				<div class="progress">
            <div class="progress-bar" role="progressbar"
               style="width: {{ (campaign.yearDonated / campaign.yearNeeded) * 100 }}%;"
               aria-valuenow="{{ campaign.yearDonated }}" aria-valuemin="0"
               aria-valuemax="{{ campaign.yearNeeded }}"></div>
				</div>
			{% else %}
				<div class="progress">
            <div class="progress-bar" role="progressbar"
               style="width: {{ (campaign.yearNeeded / campaign.yearDonated) * 100 }}%"
               aria-valuenow="campaign.yearNeeded" aria-valuemin="0" aria-valuemax="campaign.yearDonated"
               title="{{ 'donation.needed'|trans }}"></div>
            <div class="progress-bar bg-success" role="progressbar"
               style="width: {{ ((campaign.yearDonated - campaign.yearNeeded) / campaign.yearDonated) * 100 }}%"
               aria-valuenow="((campaign.yearDonated - campaign.yearNeeded) / campaign.yearDonated)"
               aria-valuemin="0" aria-valuemax="100" title="{{ 'donation.additional'|trans }}"></div>
				</div>
			{% endif %}

			<p class="u:font-display u:text-center u:mt-16 u:text-18">
				{{ '€ ' ~ campaign.yearDonated ~ '' }}
          <span class="u:ms-8">{{ 'dashboard.donation.received' | trans }}</span></p>
			{% if campaign.yearDonated >= campaign.yearNeeded %}
				<p class="u:font-display u:font-300 u:my-16 u:text-center">{{ 'donation.thank.you'|trans({'amount':'€' ~ campaign.yearNeeded})|raw }}</p>
			{% endif %}
        <a href="{{ url('donations') }}"
            class="btn o-button {% if campaign.yearDonated < campaign.yearNeeded %}o-button--full{% else %}o-button--outline{% endif %} u:my-16"><i
              class="fa u:me-8 fa-euro-sign"></i> {{ 'landing.beinvolved.pleasedonate' | trans }}</a>

		</div>

		<div class="o-card u:mb-24">
        <h4 class="homehfour">{{ 'landing.beinvolved.title' | trans }}<br/><span
            class="homesubt">{{ 'landing.beinvolved.volunteer' | trans }}</span></h4>

			<p class="u:font-display u:font-300">{{ 'landing.beinvolved.intro' | trans }}</p>
        <p class="u:font-display u:font-300"><a href="{{ url('getactive') }}" class="o-button btn o-button u:mt-16"><i
              class="fa u:me-8 fa-wrench"></i> {{ 'landing.beinvolved.helpbewelcome' | trans }}</a></p>
		</div>

		<div class="o-card">
        <h4 class="homehfour">{{ 'landing.beinformed.title' | trans }}<br/><span
            class="homesubt">{{ 'landing.beinformed.subtitle' | trans }}</span></h4>
        <a href="{{ url('about') }}"
           class="o-button btn o-button text-truncate u:mb-8"><i
            class="fa u:me-8 fa-question me-2"></i>{{ 'landing.beinformed.about' | trans }}</a>
        <a href="{{ url('about_faq') }}"
           class="o-button btn o-button text-truncate u:mb-8"><i
            class="fa u:me-8 fa-question me-2"></i>{{ 'landing.beinformed.faq' | trans }}</a>
        <a href="{{ url('safety') }}"
           class="o-button btn o-button text-truncate u:mb-8"><i
            class="fa u:me-8 fa-user-shield me-2"></i>{{ 'landing.beinformed.safety' | trans }}</a>
			<a href="{{ url('newsletters') }}" class="o-button btn o-button
          text-truncate u:mb-8"><i
            class="far fa-newspaper me-2"></i>{{ 'newsletters' | trans }}</a>
        <a href="https://www.bevolunteer.org/" target="_blank"
           class="o-button btn o-button text-truncate u:mb-8"><i
            class="fa u:me-8 fa-bullseye me-2"></i>{{ 'landing.beinformed.bevolunteer' | trans }}</a>
        <a href="https://www.bevolunteer.org/reports/annual-reports/" target="_blank"
           class="o-button btn o-button text-truncate u:mb-8"><i
            class="fa u:me-8 fa-book me-2"></i>{{ 'landing.beinformed.annualreport' | trans }}</a>
        <a href="https://www.bevolunteer.org/reports/financial-reports/" target="_blank"
           class="o-button btn o-button text-truncate u:mb-8"><i
            class="fa u:me-8 fa-money-bill-wave-alt me-2"></i>{{ 'landing.beinformed.finances' | trans }}</a>
        <a href="{{ url('terms_of_use') }}"
           class="o-button btn o-button text-truncate u:mb-8"><i
            class="fa u:me-8 fa-book me-2"></i>{{ 'landing.beinformed.termsofuse' | trans }}</a>
        <a href="{{ url('privacy_policy') }}"
           class="o-button btn o-button text-truncate u:mb-8"><i
            class="fa u:me-8 fa-book me-2"></i>{{ 'landing.beinformed.privacypolicy' | trans }}</a>
        <a href="{{ url('data_rights') }}"
           class="o-button btn o-button text-truncate u:mb-8"><i
            class="fa u:me-8 fa-book me-2"></i>{{ 'landing.beinformed.datarights' | trans }}</a>
        <a href="{{ url('about_credits') }}"
           class="o-button btn o-button text-truncate u:mb-8"><i
            class="fa u:me-8 fa-book me-2"></i>{{ 'credits.title' | trans }}</a>
		</div>
	</div>

	<div class="u:w-full">
		<div class="o-card u:h-full">
        <h4 class="homehfour">{{ 'landing.bwnews.title' | trans }}<br/><span
            class="homesubt">{{ 'landing.bwnews.subtitle' | trans }}</span></h4>
        {% for news in communityNews %}

			<h5>
				<a href="{{ url('communitynews_show', { id: news.id} ) }}">{{ news.title }}</a>
			</h5>
			<div class="community-news-wrapper u:font-display u:font-300 u:mb-8">{{ news.text | truncate(200) | raw }}</div>

			<div class="u:flex u:flex-row u:justify-between">
				<small>{{ news.createdAt.diffForHumans }}</small>
                {% set commentsCount = news.comments | length %}
                <small>{{ 'bewelcome_news.nrcomments'|trans({'%commentsCount%': commentsCount}) }}</small>
			</div>
            <a href="{{ url('communitynews_show', { id: news.id} ) }}"
               class="o-button u:my-16"><i class="fas fa-angle-double-right u:me-8"></i>{{ 'label.read.more' | trans }}
            </a>
            {% if not loop.last %}
            <div class="u:mb-16">&nbsp;</div>
            {% endif %}
        {% endfor %}
            <a href="{{ url('communitynews') }}" class="o-button btn u:mt-16"><i
            class="far fa-newspaper u:me-8"></i> {{ 'landing.bwnews.allnews' | trans }}</a>
		</div>
	</div>

</div>
{% endblock content %}
